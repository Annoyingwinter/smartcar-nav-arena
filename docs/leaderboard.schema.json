{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartcar-nav-arena/leaderboard.schema.json",
  "title": "Smartcar-Nav Arena leaderboard",
  "type": "object",
  "required": ["schema_version", "epochs", "runs", "standings"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 2 },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "scoring": {
      "type": "object",
      "required": ["subtotal_formula", "time_score"],
      "properties": {
        "reference": { "type": "string" },
        "note": { "type": "string" },
        "subtotal_formula": { "type": "string" },
        "time_score": {
          "type": "object",
          "required": ["groups"],
          "properties": {
            "groups": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": ["id", "label", "cap"],
                "properties": {
                  "id": { "type": "string", "enum": ["no-cones", "with-cones"] },
                  "label": { "type": "string" },
                  "cap": { "type": "number", "exclusiveMinimum": 0 },
                  "rule": { "type": "string" }
                }
              }
            }
          }
        },
        "model_total": { "type": "string" }
      }
    },
    "epochs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "official"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string" },
          "status": { "type": "string", "enum": ["reference", "official"] },
          "official": { "type": "boolean" },
          "date_range": { "type": "string" },
          "why": { "type": "string" },
          "comparable_with": { "type": "string" },
          "config_provenance": { "type": "string" }
        }
      }
    },
    "config_fingerprint": {
      "type": "object",
      "properties": {
        "benchmark_map_sha16": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "round1_world_sha16": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "public_baseline_yaml_sha16": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "model", "version", "epoch", "round", "group",
          "finished", "collisions", "score", "subtotal", "time_score",
          "commander_sha"
        ],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "model": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "epoch": { "type": "string" },
          "round": { "type": "string", "pattern": "^(A0|B[0-9]+)$" },
          "group": { "type": "string", "enum": ["no-cones", "with-cones"] },
          "seed": { "type": ["number", "null"] },
          "cones": { "type": ["string", "null"] },
          "finished": { "type": "boolean" },
          "sim_time_s": { "type": ["number", "null"], "minimum": 0 },
          "sim_time_lower_bound_s": { "type": ["number", "null"], "minimum": 0 },
          "collisions": { "type": "integer", "minimum": 0 },
          "collision_penalty_capped": { "type": "boolean" },
          "final_xy": {
            "type": ["array", "null"],
            "items": { "type": "number" },
            "minItems": 2, "maxItems": 2
          },
          "wp_time_s": {
            "type": ["array", "null"],
            "items": { "type": "number", "minimum": 0 }
          },
          "score": {
            "type": "object",
            "required": ["depart", "final", "cones_map", "collision", "line"],
            "additionalProperties": false,
            "properties": {
              "depart": { "type": "integer", "enum": [0, 5] },
              "final": { "type": "integer", "enum": [0, 10] },
              "cones_map": { "type": "integer", "enum": [0, 5] },
              "collision": { "type": "integer", "enum": [0, -2, -4, -5] },
              "line": { "type": "integer", "enum": [0, -2] }
            }
          },
          "subtotal": { "type": "integer", "minimum": -5, "maximum": 20 },
          "time_score": { "type": "number", "minimum": 0, "maximum": 5 },
          "commander_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{8,64}$",
            "description": "SHA-256 的十六进制串。历史迁移行只有 8 位前缀(见 sha_policy);新提交给完整 64 位。"
          },
          "reproduced_from": { "type": "string" },
          "notes": { "type": "string" },
          "deviation_note": { "type": "string" },
          "sha_note": { "type": "string" }
        }
      }
    },
    "standings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "since": { "type": "string" }
        }
      }
    },
    "sha_policy": {
      "type": "object",
      "properties": {
        "field": { "type": "string" },
        "rule": { "type": "string" },
        "why": { "type": "string" },
        "historical_rows_are_prefixes_only": { "type": "boolean" }
      }
    },
    "disclosure": { "type": "object" }
  }
}