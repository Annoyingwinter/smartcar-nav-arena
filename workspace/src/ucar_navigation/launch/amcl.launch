# ============================================================================
# 【基线待考据】请勿把这个文件的取值当成"大会出厂默认值"。
#
# 大会教程《第一轮分站赛控制教程》"4、参数"一节只列出了 5 个参数文件的文件名
# 与各自用途，**未给出任何数值**，所以这些值的出处无法考证。
# 本文件取自最早可考快照(2026-09-30)；逐项判断依据、哪些项存疑、以及
# 本文件的 SHA-256，全部记录在 docs/CONFIG_PROVENANCE.md。
#
# 参赛者**可以自由调整**本文件 —— 大会细则允许改 move_base/AMCL 的这 5 个
# 配置文件。提交成绩时请附上你改动后版本的 SHA-256 前 16 位。
#
# 标了 [待考据] 的参数：在最早可考快照与后期版本里取值**相同**，因此无法证明
# 它是原厂值还是已经被改过。若你从大会原始包里找到了不同的值，请提 PR 修正
# docs/CONFIG_PROVENANCE.md 并同步本文件。
# ============================================================================
<launch>
    <!-- 初始位姿默认对齐 gazebo.launch 里 car3 的出生点 (1.72, 0.27, -π/2) -->
    <arg name="scan_topic" default="scan"/>
    <arg name="initial_pose_x" default="1.72"/>
    <arg name="initial_pose_y" default="0.27"/>
    <arg name="initial_pose_a" default="-1.5708"/>

    <node pkg="amcl" type="amcl" name="amcl" clear_params="true">
        <param name="min_particles"             value="500"/>
        <param name="max_particles"             value="3000"/>
        <param name="kld_err"                   value="0.02"/>
        <param name="update_min_d"              value="0.10"/>
        <param name="update_min_a"              value="0.15"/>
        <param name="resample_interval"         value="1"/>
        <param name="transform_tolerance"       value="0.1"/>
        <param name="recovery_alpha_slow"       value="0.00"/>
        <param name="recovery_alpha_fast"       value="0.00"/>
        <param name="initial_pose_x"            value="$(arg initial_pose_x)"/>
        <param name="initial_pose_y"            value="$(arg initial_pose_y)"/>
        <param name="initial_pose_a"            value="$(arg initial_pose_a)"/>
        <param name="gui_publish_rate"          value="50.0"/>

        <remap from="scan"                      to="$(arg scan_topic)"/>
        <param name="laser_max_range"           value="10.0"/>
        <param name="laser_max_beams"           value="180"/>
        <param name="laser_z_hit"               value="0.8"/>
        <param name="laser_z_short"             value="0.05"/>
        <param name="laser_z_max"               value="0.05"/>
        <param name="laser_z_rand"              value="0.2"/>
        <param name="laser_sigma_hit"           value="0.1"/>
        <param name="laser_lambda_short"        value="0.1"/>
        <param name="laser_likelihood_max_dist" value="2.0"/>
        <param name="laser_model_type"          value="likelihood_field"/>

        <param name="odom_model_type"           value="diff"/>
        <param name="odom_alpha1"               value="0.05"/>
        <param name="odom_alpha2"               value="0.05"/>
        <param name="odom_alpha3"               value="0.05"/>
        <param name="odom_alpha4"               value="0.05"/>
        <param name="odom_frame_id"             value="odom"/>
        <param name="base_frame_id"             value="base_footprint"/>
    </node>
</launch>
